<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 【知识点】Android 11+ 包可见性限制：不声明 <queries>，
         getLaunchIntentForPackage("抖音包名") 会返回 null，像没装一样 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 【关键】悬浮窗权限是 AOSP 对"后台启动 Activity"禁令的经典豁免证：
         持有它的 App（前台服务/广播里）startActivity 不会被系统拦。
         声明即可，授权走 adb appops（或设置页"后台弹出界面"同家族） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 开机恢复闹钟预约用（配合 BootReceiver） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 电池优化豁免申请页（全品牌防 Doze 拖死闹钟） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- PACKAGE_USAGE_STATS 是"特殊"权限：清单里声明只是登记，
         真正放行要用户去设置页开（或 adb appops） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ForceAlarm">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ForceAlarm"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 【单实例】闹钟双通道（FSI + startActivity）会叠出两层界面、两份铃声，
             singleTask 保证全局只有一实例：后到的启动只会复用并置顶它 -->
        <activity
            android:name=".ui.LockScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.example.forcealarm.lock"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 开机广播由系统（另一个进程）发来，exported 必须为 true 才能送达 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 解锁计时前台服务：Android 14+ 必须声明类型，
             specialUse = 闹钟类不属于其它标准类型的合理归类 -->
        <service
            android:name=".alarm.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_unlock_usage_watch" />
        </service>
    </application>

</manifest>